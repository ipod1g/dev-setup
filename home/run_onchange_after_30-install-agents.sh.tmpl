{{ if and .installAgents (ne .chezmoi.os "windows") -}}
#!/bin/sh
set -eu
export PATH="$HOME/.local/bin:$PATH"
{{ if eq .chezmoi.os "darwin" -}}
# node@24 is keg-only; do not depend on a new terminal inheriting its PATH.
if command -v brew >/dev/null 2>&1; then
  export PATH="$(brew --prefix node@24)/bin:$PATH"
fi
{{ end -}}
if ! command -v codex >/dev/null 2>&1; then
  command -v npm >/dev/null 2>&1 || { echo 'Node.js/npm is required to install Codex; install Node LTS in this environment.' >&2; exit 1; }
  npm install --global @openai/codex
fi
command -v curl >/dev/null 2>&1 || { echo 'curl is required to download agent installers.' >&2; exit 1; }
installer=$(mktemp)
trap 'rm -f "$installer"' EXIT HUP INT TERM
if ! command -v claude >/dev/null 2>&1; then
  curl -fsSL https://claude.ai/install.sh -o "$installer"
  bash "$installer"
fi
if ! command -v t3 >/dev/null 2>&1; then
{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") -}}
  # Upstream provides an Intel desktop app, but no Intel standalone server binary.
  command -v brew >/dev/null 2>&1 || { echo 'Homebrew is required for the Intel T3 desktop app.' >&2; exit 1; }
  brew install --cask t3-code
  echo 'Intel Mac: open T3 Code desktop; install its t3 command from Settings > General > About.'
{{ else -}}
  curl -fsSL https://t3.codes/install.sh -o "$installer"
  sh "$installer"
{{ end -}}
fi
printf '%s\n' 'Sign in separately: codex, claude, and gh auth login. Ensure ~/.local/bin is on PATH.'
{{ end -}}
