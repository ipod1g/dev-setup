{{ if and .installPackages (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -eu
command -v brew >/dev/null 2>&1 || { echo 'Install Homebrew first: https://brew.sh' >&2; exit 1; }
brew bundle --no-upgrade --file=- <<'BREWFILE'
{{ range .packages.macos.formulae -}}
brew "{{ . }}"
{{ end -}}
{{ range .packages.macos.apps -}}
cask "{{ .cask }}" unless ["/Applications/{{ .app }}", File.expand_path("~/Applications/{{ .app }}")].any? { |path| File.directory?(path) }
{{ end -}}
{{ if ne .editor "none" -}}
cask "{{ index .packages.macos.editors .editor }}" unless ["/Applications/{{ index .packages.macos.editorApps .editor }}", File.expand_path("~/Applications/{{ index .packages.macos.editorApps .editor }}")].any? { |path| File.directory?(path) }
{{ end -}}
{{ if eq .editor "vscode" -}}
{{ range .packages.macos.vscodeFormulae -}}
brew "{{ . }}"
{{ end -}}
{{ range .packages.macos.vscodeCasks -}}
cask "{{ . }}"
{{ end -}}
{{ else if .legacyNeovim -}}
brew "neovim"
{{ end -}}
BREWFILE
{{ end -}}
