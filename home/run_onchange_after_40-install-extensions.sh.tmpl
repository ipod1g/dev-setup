{{ if and (eq .chezmoi.os "darwin") (ne .editor "none") .installPackages -}}
#!/bin/sh
set -eu
editor_command={{ .editor | quote }}
{{ if eq .editor "vscode" -}}
editor_command=code
{{ end -}}
if ! command -v "$editor_command" >/dev/null 2>&1; then
  if [ "$editor_command" = cursor ]; then
    editor_command='/Applications/Cursor.app/Contents/Resources/app/bin/cursor'
  else
    editor_command='/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code'
  fi
fi
[ -x "$editor_command" ] || command -v "$editor_command" >/dev/null 2>&1 || { echo 'Editor CLI not found; install it from the editor command palette and rerun chezmoi apply.' >&2; exit 1; }
{{ range .extensions -}}
"$editor_command" --install-extension {{ . | quote }}
{{ end -}}
{{ if eq .editor "cursor" -}}
"$editor_command" --install-extension anysphere.remote-ssh
"$editor_command" --install-extension anysphere.remote-wsl
{{ else -}}
"$editor_command" --install-extension ms-vscode-remote.remote-ssh
{{ end -}}
{{ end -}}
